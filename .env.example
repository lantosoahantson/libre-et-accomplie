# Copiez ce fichier en `.env.local` et remplacez les valeurs factices.
# `.env.local` est ignoré par Git : il ne sera jamais publié.
# Ne collez JAMAIS ces valeurs dans une conversation.

# Supabase → Project Settings → API (ou « Data API »)
# « Project URL »
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clé publique : « anon public » (ancien format, commence par eyJ…)
# ou « Publishable key » (nouveau format, commence par sb_publishable_…). Les deux fonctionnent.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Adresse de l'application (utilisée pour les liens de connexion). En local, laissez ainsi.
VITE_SITE_URL=http://localhost:5173
