{
  "name": "le-cocon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "bash scripts/test-rls.sh",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:rls",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "icons": "node scripts/generate-icons.mjs",
    "supabase": "npx supabase@latest",
    "db:start": "npx supabase@latest start",
    "db:stop": "npx supabase@latest stop",
    "db:reset": "npx supabase@latest db reset",
    "db:push": "npx supabase@latest db push",
    "db:types": "npx supabase@latest gen types typescript --local > src/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.115.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
